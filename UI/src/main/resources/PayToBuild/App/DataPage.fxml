<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="mainroot" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="PayToBuild.App.DataController" stylesheets="@DataPage.css">
    <children>
        <Group layoutX="-18.0" layoutY="-3.0">
            <children>
                <Rectangle fx:id="bcrectangle" arcHeight="5.0" arcWidth="5.0" fill="#949ba1" height="61.0" stroke="BLACK"
                           strokeType="INSIDE" width="${mainroot.width+20}"/>
                <Button fx:id="guidebutton" layoutX="${mainroot.width-149}" layoutY="17.0"
                        maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity"
                        minWidth="-Infinity" mnemonicParsing="false" onAction="#swaptoguide" onMouseEntered="#changecursor"
                        onMouseExited="#changecursor" text="Guide"/>
                <Button fx:id="loginbutton" layoutX="${mainroot.width-68}" layoutY="17.0" mnemonicParsing="false"
                        onAction="#swaptologin" onMouseEntered="#changecursor" onMouseExited="#changecursor" text="Log In"/>
                <Label fx:id="toplabel" layoutX="${(mainroot.width/2)-60}" layoutY="9.0" maxHeight="1.7976931348623157E308"
                       maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="44.0"
                       prefWidth="282.0" text="Pay To Build"  onMouseClicked="#backtomain" onMouseEntered="#changecursor" onMouseExited="#changecursor">
                    <font>
                        <Font name="Cambria" size="35.0"/>
                    </font>
                </Label>
            </children>
        </Group>
        <Group>
            <Label fx:id="data_name" layoutX="${(mainroot.width/2-70)}" layoutY="100"  maxHeight="1.7976931348623157E308"
                   maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0"
                   prefWidth="282.0">
                <font>
                    <Font name="Cambria" size="50.0" />
                </font>
            </Label>
            <ScrollPane fx:id="scrollPane"   layoutX="${(mainroot.width*0.2)}" layoutY="200"  maxHeight="1.7976931348623157E308"
                        maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="${(mainroot.height-300)}" prefWidth="${(mainroot.width*0.6)}" >
                <VBox fx:id="dynamiccontainer">
                </VBox>
            </ScrollPane>
        </Group>
    </children>
</AnchorPane>
