<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="cardroot" maxWidth="1.7976931348623157E308" prefHeight="400" prefWidth="500" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PayToBuild.App.CardController">
    <children>
        <TitledPane prefHeight="${cardroot.height}" prefWidth="${cardroot.width}" text="">
            <graphic>
                <HBox alignment="CENTER_LEFT" prefHeight="40" prefWidth="${cardroot.width}" spacing="10">
                    <children>
                        <Label fx:id="partname" text="" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="addPart" onAction="#addElement"  text="+Add" />
                    </children>
                </HBox>
            </graphic>
            <content>
                <VBox fx:id="carddataroot">

                </VBox>
            </content>
        </TitledPane>
    </children>
</AnchorPane>
